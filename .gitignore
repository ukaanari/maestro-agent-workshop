# Python
__pycache__/
*.py[cod]

# MAESTRO runtime state (SQLite database, task worktrees, private homes).
# It contains absolute local paths and must never be committed.
.maestro/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets, credentials and certificates (.github/scripts/privacy_scan.py also blocks them)
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
!*.pub
.netrc
.pypirc
.npmrc
.git-credentials
credentials.json
.credentials.json
service-account*.json

